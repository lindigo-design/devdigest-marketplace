{
  "description": "Read-only Bash guard for architecture-reviewer: allows only read-only git commands inside the repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.mjs\" architecture-review:architecture-reviewer=review",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
