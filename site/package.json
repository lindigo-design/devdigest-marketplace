{
  "name": "lindigo-devdigest-catalog",
  "private": true,
  "type": "module",
  "description": "Static catalog site for the lindigo-devdigest Claude Code plugin marketplace (spec CAT-01).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"test/unit/**/*.test.mjs\"",
    "fonts": "node scripts/fonts-css.mjs",
    "check": "node scripts/check-catalog.mjs",
    "test:build": "node --test --test-concurrency=1 \"test/build/**/*.test.mjs\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.5",
    "minisearch": "7.2.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "fast-xml-parser": "5.11.2"
  }
