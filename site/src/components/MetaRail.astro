---
// Key/value rows for the page rail (prototype "Details" rail): version, category, license, dates.
interface Props { rows: { k: string; v: string | null; mono?: boolean; href?: string }[] }
const rows = Astro.props.rows.filter((r) => r.v);
---
<dl class="meta">
  {rows.map((r) => (
    <div class="meta__row">
      <dt class="t-label">{r.k}</dt>
      <dd class:list={[{ "t-mono": r.mono }]}>{r.href ? <a href={r.href}>{r.v}</a> : r.v}</dd>
    </div>
  ))}
</dl>

<style>
  .meta { margin: 0; }
  .meta__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: var(--rule-thin) solid var(--rule-hairline);
  }
  dd { margin: 0; text-align: right; overflow-wrap: anywhere; font-size: var(--type-mono); }
</style>
