---
// Compatibility badges (spec CAT-01 R10/AC-1, AC-3, AC-4; tokens §5 CompatBadge).
import { badgeLabels } from "../../lib/compatibility.mjs";
import { t } from "../i18n/t.mjs";
interface Props {
  compat: { declared: boolean; claudeCode: string | null; verifiedOn: string | null; os: string[] };
  verified?: boolean; // show "verified on X" (plugin page, R10/AC-4)
}
const { compat, verified = false } = Astro.props;
const [first, ...os] = badgeLabels(compat);
---
<ul class="badges" aria-label={t("compat.title")}>
  <li class:list={["badge", { "badge--undeclared": !compat.declared }]}>{first}</li>
  {os.map((o) => <li class="badge">{o}</li>)}
  {verified && compat.verifiedOn && <li class="badge badge--note">{t("compat.verified", { version: compat.verifiedOn })}</li>}
</ul>

<style is:global>
  /* Global: src/client/render.mjs builds the same markup for live results, without Astro's scope attributes. */
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .badge {
    padding: 0 var(--space-3);
    border: var(--rule-thin) solid var(--rule-hairline);
    border-radius: var(--radius-pill);
    font-size: var(--type-label);
    line-height: var(--leading-mono);
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  /* AA: secondary text on a dashed whisper outline (design-tokens.md §5). */
  .badge--undeclared { border-style: dashed; border-color: var(--ink-whisper); }
  .badge--note { border-color: transparent; padding-inline: 0; font-family: var(--font-mono); }
</style>
