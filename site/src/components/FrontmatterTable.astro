---
// Frontmatter as one wrapping line of key/value pairs separated by "·" (spec CAT-01 R5/AC-4; agents list
// tools, model, skills first; tokens §5 Frontmatter line, owner review 2026-11-10: was a two-column table).
// Values are strings, lists (joined) or nested objects (shown as YAML, on a line of their own).
// `env` is already removed upstream.
import { stringify } from "yaml";
import { t } from "../i18n/t.mjs";
interface Props { data: Record<string, unknown>; first?: string[]; caption?: string }
const { data, first = [], caption = t("frontmatter.caption") } = Astro.props;
const keys = [...first.filter((k) => k in data), ...Object.keys(data).filter((k) => !first.includes(k))];
const show = (v: unknown) =>
  Array.isArray(v) && v.every((x) => typeof x !== "object") ? v.join(", ")
  : v !== null && typeof v === "object" ? stringify(v).trimEnd()
  : String(v);
---
{keys.length > 0 && (
  <div class="fm">
    <p class="t-label fm__caption">{caption}</p>
    <dl class="fm__list t-mono">
      {keys.map((k) => {
        const v = show(data[k]);
        const block = v.includes("\n");
        return (
          <div class={block ? "fm__item fm__item--block" : "fm__item"}>
            <dt>{k}</dt>
            <dd>{block ? <pre>{v}</pre> : v}</dd>
          </div>
        );
      })}
    </dl>
  </div>
)}

<style>
  /* No rule between the caption and the pairs: they belong together (proximity; owner review 2026-11-10).
     The section's own top rule separates the frontmatter from what is above it. */
  .fm__caption { margin: 0 0 var(--space-2); }
  .fm__list { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) 0; margin: 0; }
  .fm__item { display: inline-flex; align-items: baseline; gap: var(--space-2); min-width: 0; }
  /* The separator is decoration (screen readers read a description list). It trails each pair, so a wrapped
     line never starts with "·". */
  .fm__item:not(:last-child, .fm__item--block, :has(+ .fm__item--block))::after {
    content: "·";
    padding-inline: var(--space-1) var(--space-3);
    color: var(--ink-secondary);
  }
  .fm__item--block { flex-basis: 100%; flex-direction: column; gap: var(--space-1); }
  dt { color: var(--ink-secondary); }
  dd { margin: 0; color: var(--ink-primary); overflow-wrap: anywhere; }
  pre { margin: 0; white-space: pre-wrap; }
</style>
