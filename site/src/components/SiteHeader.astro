---
// Site header: brand, search shortcut hint, catalog and GitHub links, theme switch (R7/AC-2; tokens §5 ThemeSwitch).
// The switch is wired by src/client/theme.mjs; without JavaScript it is hidden and the OS preference applies.
import { config, getCatalog, href } from "../data/site.mjs";
import { t } from "../i18n/t.mjs";
const name = getCatalog().marketplace.name;
const THEMES = [["auto", t("theme.auto")], ["light", t("theme.light")], ["dark", t("theme.dark")]];
---
<header class="site-header rule-bottom">
  <a class="site-header__brand" href={href()}>{name}</a>
  <nav aria-label={t("header.nav.aria")} class="site-header__nav t-caption">
    <span class="site-header__hint" data-js-only><kbd>/</kbd> {t("header.searchHint")}</span>
    <a href={href()}>{t("header.catalog")}</a>
    <a href={config.repo}>{t("nav.github")}</a>
    <span class="theme" role="group" aria-label={t("theme.aria")} data-js-only data-theme-switch>
      {THEMES.map(([v, label]) => <button type="button" class="theme__option" data-theme-value={v} aria-pressed={v === "auto" ? "true" : "false"}>{label}</button>)}
    </span>
  </nav>
</header>

<style>
  /* Sticky (tokens §5 SiteHeader): above page content, below the mobile filter drawer (z 40) and the skip link (z 50). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--surface-page);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
  }
  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--type-heading-2);
    font-weight: var(--weight-semibold);
    color: var(--ink-primary);
    text-decoration: none;
  }
  .site-header__brand:hover { color: var(--accent-indigo); }
  .site-header__nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .site-header__hint { display: inline-flex; align-items: center; gap: var(--space-2); }
  kbd {
    padding: 0 var(--space-2);
    border: var(--rule-thin) solid var(--rule-hairline);
    border-radius: var(--radius-s);
    font-size: var(--type-label);
    color: var(--ink-primary);
  }
  /* ThemeSwitch (tokens §5): three text buttons; the selected one is ink/primary with an indigo strong underline. */
  .theme { display: inline-flex; align-items: center; gap: var(--space-3); }
  .theme__option {
    padding: 0;
    border: 0;
    border-bottom: var(--rule-strong) solid transparent;
    background: none;
    font: inherit;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: color var(--duration-quick) var(--ease-settle), border-color var(--duration-quick) var(--ease-settle);
  }
  .theme__option:hover { color: var(--accent-indigo); }
  .theme__option[aria-pressed="true"] { color: var(--ink-primary); border-bottom-color: var(--accent-indigo); }
  :global(html:not(.js)) [data-js-only] { display: none; }
</style>
