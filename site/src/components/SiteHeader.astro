---
// Site header: brand, search shortcut hint, catalog and GitHub links, theme switch (R7/AC-2; tokens §5 ThemeSwitch).
// The switch is wired by src/client/theme.mjs; without JavaScript it is hidden and the OS preference applies.
import { config, getCatalog, href } from "../data/site.mjs";
import { t } from "../i18n/t.mjs";
const name = getCatalog().marketplace.name;
---
<header class="site-header rule-bottom">
  <a class="site-header__brand" href={href()}>{name}</a>
  <nav aria-label={t("header.nav.aria")} class="site-header__nav t-caption">
    <span class="site-header__hint" data-js-only><kbd>/</kbd> {t("header.searchHint")}</span>
    <a href={href()}>{t("header.catalog")}</a>
    <a href={config.repo}>{t("nav.github")}</a>
    <button type="button" class="theme-switch" role="switch" aria-checked="false" aria-label={t("theme.switch.aria")} data-js-only data-theme-switch>
      <span class="theme-switch__knob" aria-hidden="true">
        <svg class="theme-switch__icon theme-switch__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="theme-switch__icon theme-switch__icon--moon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.5 14.4A8.5 8.5 0 0 1 9.6 3.5a8.5 8.5 0 1 0 10.9 10.9Z" />
        </svg>
      </span>
    </button>
  </nav>
</header>

<style>
  /* Sticky (tokens §5 SiteHeader): above page content, below the mobile filter drawer (z 40) and the skip link (z 50). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--surface-page);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5);
  }
  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--type-heading-2);
    font-weight: var(--weight-semibold);
    color: var(--ink-primary);
    text-decoration: none;
  }
  .site-header__brand:hover { color: var(--accent-indigo); }
  .site-header__nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .site-header__hint { display: inline-flex; align-items: center; gap: var(--space-2); }
  kbd {
    padding: 0 var(--space-2);
    border: var(--rule-thin) solid var(--rule-hairline);
    border-radius: var(--radius-s);
    font-size: var(--type-label);
    color: var(--ink-primary);
  }
  /* ThemeSwitch (tokens §5): pill track, indigo knob with a sun (left, light) or moon (right, dark). The knob
     position and icon follow the same selectors as the dark tokens (§8), so they always match the page. */
  .theme-switch {
    --knob-travel: calc(var(--space-7) - var(--space-5) - 2 * var(--rule-strong) - 2 * var(--rule-thin));
    display: inline-flex;
    align-items: center;
    width: var(--space-7);
    height: calc(var(--space-5) + 2 * var(--rule-strong) + 2 * var(--rule-thin));
    padding: var(--rule-strong);
    border: var(--rule-thin) solid var(--rule-hairline);
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    cursor: pointer;
    transition: border-color var(--duration-quick) var(--ease-settle);
  }
  .theme-switch:hover { border-color: var(--accent-indigo); }
  .theme-switch__knob {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-5);
    height: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--accent-indigo);
    color: var(--surface-page);
    transition: transform var(--duration-base) var(--ease-settle);
  }
  .theme-switch__icon { width: var(--space-4); height: var(--space-4); }
  .theme-switch__icon--moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-switch__knob { transform: translateX(var(--knob-travel)); }
    :global(:root:not([data-theme="light"])) .theme-switch__icon--sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme-switch__icon--moon { display: block; }
  }
  :global(:root[data-theme="dark"]) .theme-switch__knob { transform: translateX(var(--knob-travel)); }
  :global(:root[data-theme="dark"]) .theme-switch__icon--sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-switch__icon--moon { display: block; }
  :global(html:not(.js)) [data-js-only] { display: none; }
</style>
