---
// Compact install block (spec CAT-02 R2/AC-11, amending CAT-01 R5/AC-3; tokens §5 InstallBlock): the one-step
// command, the dependencies Claude Code installs with it, and a link to the plugin page's install panel for the
// other scopes and the terminal.
import { t } from "../i18n/t.mjs";
import CopyCommand from "./CopyCommand.astro";
interface Props {
  plugin: string;
  command: string;
  alsoInstalls: { name: string; range: string | null }[];
  title?: string;
  panelHref?: string;
}
const { plugin, command, alsoInstalls, title = t("install.title"), panelHref } = Astro.props;
const headingId = `install-${plugin}`;
---
<section class="install" aria-labelledby={headingId}>
  <h2 id={headingId} class="t-label">{title}</h2>
  <CopyCommand command={command} label={t("install.label.install", { plugin })} />
  {alsoInstalls.length > 0 && (
    <p class="install__also t-mono">
      {t("install.also")} {alsoInstalls.map((d, i) => <>{i > 0 && ", "}{d.name}{d.range && ` ${d.range}`}</>)}
    </p>
  )}
  {panelHref && <p class="t-caption"><a href={panelHref}>{t("install.more")}</a></p>}
</section>

<style>
  .install {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    background: var(--surface-raised);
    border: var(--rule-thin) solid var(--rule-hairline);
  }
  .install__also { font-size: var(--type-caption); color: var(--ink-secondary); overflow-wrap: anywhere; }
</style>
