---
// Kind label: text only, no icon (tokens §5 KindLabel; brief: no emoji type icons).
// Labels come from src/client/render.mjs, which also renders them in live results.
import { KIND_LABELS } from "../client/render.mjs";
interface Props { kind: keyof typeof KIND_LABELS; class?: string }
const { kind, class: cls } = Astro.props;
---
<span class:list={["t-label", "kind-label", cls]} data-kind={kind}>{KIND_LABELS[kind] ?? kind}</span>
