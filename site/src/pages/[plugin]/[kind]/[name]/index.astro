---
// Component page /<plugin>/<kind>/<name>/ (spec CAT-01 R5/AC-1, AC-4–6; R3/AC-3; R10/AC-1).
// Variants: skill / agent / command (frontmatter + body), hook (R5/AC-5), MCP server.
import { transitiveDependencies } from "../../../../../lib/graph.mjs";
import CompatBadge from "../../../../components/CompatBadge.astro";
import FrontmatterTable from "../../../../components/FrontmatterTable.astro";
import InstallBlock from "../../../../components/InstallBlock.astro";
import KindLabel from "../../../../components/KindLabel.astro";
import MetaRail from "../../../../components/MetaRail.astro";
import Prose from "../../../../components/Prose.astro";
import Relations from "../../../../components/Relations.astro";
import RunsCommandsMarker from "../../../../components/RunsCommandsMarker.astro";
import { getCatalog, githubSource, href, install, markdown } from "../../../../data/site.mjs";
import { t } from "../../../../i18n/t.mjs";
import Base from "../../../../layouts/Base.astro";

export function getStaticPaths() {
  return getCatalog()
    .entries.filter((e) => e.kind !== "plugin")
    .map((entry) => ({ params: { plugin: entry.plugin, kind: entry.kind, name: entry.slug }, props: { entry } }));
}

const { entry: c } = Astro.props;
const catalog = getCatalog();
const page = c.page;
const hook = page.hook;
const mcp = page.mcp;
const AGENT_FIRST = ["tools", "model", "skills"];
const hasBody = typeof page.body === "string" && page.body.trim().length > 0;
// The description is already in the page head (tokens §5 Component page), so the table leaves it out.
const frontmatter = page.frontmatter
  ? Object.fromEntries(Object.entries(page.frontmatter).filter(([k]) => k !== "description"))
  : null;
const hasRelations = (c.page.preloads?.length ?? 0) + (c.page.preloadedBy?.length ?? 0) > 0;
---
<Base title={t("component.title", { name: c.name, kind: c.kind })} description={c.description} path={c.path}>
  <header class="page-head">
    <a class="t-caption" href={href(`${c.plugin}/`)}>{t("component.back", { plugin: c.plugin })}</a>
    <KindLabel kind={c.kind} class="page-head__kind" />
    <h1 class="t-display page-head__title">{c.name}</h1>
    <p class="t-body-lg t-secondary page-head__in">
      {t("component.inPlugin")} <a href={href(`${c.plugin}/`)}>{c.plugin}</a> <span class="t-mono">· {t("version", { version: c.version })}</span>
    </p>
    <p class="t-body-lg t-secondary measure">{c.description}</p>
  </header>

  <div class="layout-rail">
    <aside aria-label={t("details.aria")} class="rail">
      <MetaRail rows={[
        { k: t("field.kind"), v: c.kind },
        { k: t("field.plugin"), v: c.plugin, href: href(`${c.plugin}/`) },
        { k: t("field.version"), v: c.version, mono: true },
      ]} />
      {hasRelations && (
        <div class="rail__block">
          <Relations plugin={c.plugin} preloads={c.page.preloads} preloadedBy={c.page.preloadedBy} />
        </div>
      )}
      <p class="rail__block rule-bottom t-caption"><a href={githubSource(c.source)}>{t("component.viewSource")}</a></p>
    </aside>

    <div class="main">
      <div class="facts">
        {c.tags?.length > 0 && (
          <div class="facts__group">
            <h2 class="t-label">{t("tags")}</h2>
            <ul class="tags">{c.tags.map((tag: string) => <li><a class="tag t-mono" href={href(`?tag=${encodeURIComponent(tag)}`)}>{tag}</a></li>)}</ul>
          </div>
        )}
        <div class="facts__group">
          <h2 class="t-label">{t("compat.title")}</h2>
          <CompatBadge compat={c.compat} />
        </div>
      </div>

      {/* Install sits right under the facts, as on the plugin page, not after a long body (owner review 2026-11-10). */}
      <InstallBlock title={t("install.titleWith", { plugin: c.plugin })} plugin={c.plugin} command={install(c.plugin).install}
        alsoInstalls={transitiveDependencies(catalog.plugins, c.plugin)} panelHref={href(`${c.plugin}/#install`)} />

      {hook && (
        <section class="block" aria-labelledby="hook">
          <h2 id="hook" class="t-heading-2">{t("component.hook")}</h2>
          <p class="t-secondary">{hook.summary}</p>
          <dl class="kv">
            <dt class="t-label">{t("component.hook.event")}</dt><dd class="t-mono">{hook.event}</dd>
            <dt class="t-label">{t("component.hook.matcher")}</dt><dd class="t-mono">{hook.matcher ?? t("component.hook.matcher.all")}</dd>
            <dt class="t-label">{t("component.hook.type")}</dt><dd class="t-mono">{hook.type}</dd>
            {hook.command && <><dt class="t-label">{t("component.hook.command")}</dt><dd><code class="kv__code">{hook.command}</code></dd></>}
            {hook.url && <><dt class="t-label">{t("component.hook.url")}</dt><dd class="t-mono">{hook.url}</dd></>}
            {hook.script && <><dt class="t-label">{t("component.hook.script")}</dt><dd class="t-mono"><a href={githubSource(c.source)}>{hook.script}</a></dd></>}
            {hook.timeout !== null && <><dt class="t-label">{t("component.hook.timeout")}</dt><dd class="t-mono">{t("component.hook.timeout.value", { seconds: hook.timeout })}</dd></>}
            <dt class="t-label">{t("field.declaredIn")}</dt><dd class="t-mono"><a href={githubSource(hook.config)}>{hook.config}</a></dd>
          </dl>
          <RunsCommandsMarker runs={c.runs} />
        </section>
      )}

      {mcp && (
        <section class="block" aria-labelledby="mcp">
          <h2 id="mcp" class="t-heading-2">{t("component.mcp")}</h2>
          <dl class="kv">
            <dt class="t-label">{t("component.mcp.server")}</dt><dd class="t-mono">{c.name}</dd>
            <dt class="t-label">{t("component.mcp.transport")}</dt><dd class="t-mono">{mcp.transport}</dd>
            <dt class="t-label">{t("field.declaredIn")}</dt><dd class="t-mono"><a href={githubSource(c.source)}>{c.source}</a></dd>
          </dl>
        </section>
      )}

      {frontmatter && Object.keys(frontmatter).length > 0 && (
        <section class="block" aria-label={t("frontmatter.caption")}>
          <FrontmatterTable data={frontmatter} first={c.kind === "agent" ? AGENT_FIRST : ["name"]} />
          <RunsCommandsMarker runs={c.runs} />
        </section>
      )}

      {hasBody && (
        <div class="block">
          <Prose html={markdown(page.body, c.source)} source={c.source} sourceHref={githubSource(c.source)} />
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  /* Same layout as the plugin page (tokens §5 Component page). */
  .page-head { display: flex; flex-direction: column; gap: var(--space-3); padding-block: var(--space-8) var(--space-7); }
  .page-head :global(.page-head__kind) { margin-top: var(--space-6); }
  .page-head__title { animation: wipe-in var(--duration-reveal) var(--ease-settle) both; }
  .page-head__in { display: flex; flex-wrap: wrap; gap: 0 var(--space-2); align-items: baseline; }
  .rail { display: flex; flex-direction: column; min-width: 0; }
  .rail__block { display: flex; flex-direction: column; gap: var(--space-2); padding-block: var(--space-4); border-top: var(--rule-thin) solid var(--rule-hairline); }
  /* One content width for the whole main column (tokens §5 Page main column, owner review 2026-11-10): tags,
     install, frontmatter and the text share one right edge; the copy field, settings snippet and prose fill it
     instead of stopping at their own measure. */
  .main { display: flex; flex-direction: column; gap: var(--space-7); min-width: 0; max-width: calc(var(--measure) * 1.5); }
  .main :global(.copy), .main :global(.snippet), .main :global(.prose) { max-width: none; }
  /* Tags, then compatibility below: two kinds of information, one per line (owner review 2026-11-10). */
  .facts { display: flex; flex-direction: column; gap: var(--space-5); }
  .facts__group { display: flex; flex-direction: column; gap: var(--space-2); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .tag {
    display: inline-block;
    padding: 0 var(--space-2);
    background: var(--surface-sunken);
    border-radius: var(--radius-s);
    font-size: var(--type-label);
    color: var(--ink-secondary);
    text-decoration: none;
  }
  .tag:hover { color: var(--accent-indigo); }
  .block { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-5); border-top: var(--rule-thin) solid var(--rule-hairline); }
  .kv { display: grid; grid-template-columns: minmax(0, auto) minmax(0, 1fr); gap: var(--space-2) var(--space-5); margin: 0; }
  .kv dd { margin: 0; overflow-wrap: anywhere; }
  .kv__code { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
