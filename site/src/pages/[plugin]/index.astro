---
// Plugin page /<plugin>/ (spec CAT-01 R5/AC-1–3, R1/AC-4, R10/AC-1, AC-4; §7 unsatisfied range).
import { repoSlug } from "../../../lib/config.mjs";
import { transitiveDependencies } from "../../../lib/graph.mjs";
import { installModel } from "../../../lib/install.mjs";
import CompatBadge from "../../components/CompatBadge.astro";
import ComponentGroups from "../../components/ComponentGroups.astro";
import DependencyLink from "../../components/DependencyLink.astro";
import DownloadLink from "../../components/DownloadLink.astro";
import EmptyState from "../../components/EmptyState.astro";
import InstallPanel from "../../components/InstallPanel.astro";
import KindLabel from "../../components/KindLabel.astro";
import ManageBlock from "../../components/ManageBlock.astro";
import MetaRail from "../../components/MetaRail.astro";
import Prose from "../../components/Prose.astro";
import TryIt from "../../components/TryIt.astro";
import { config, getCatalog, githubSource, href, markdown } from "../../data/site.mjs";
import { t } from "../../i18n/t.mjs";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return getCatalog().plugins.map((plugin) => ({ params: { plugin: plugin.name }, props: { plugin } }));
}

const { plugin: p } = Astro.props;
const catalog = getCatalog();
const byId = new Map(catalog.entries.map((e) => [e.id, e]));
const versionOf = (name: string) => catalog.plugins.find((x) => x.name === name)?.version;
const components = p.page.components.map((id: string) => byId.get(id));
const latest = p.page.latestRelease;
const compat = p.page.compatibility;

// Install and use (spec CAT-02): commands for every scope and surface, dependencies, context cost.
const deps = transitiveDependencies(catalog.plugins, p.name);
const depPlugins = deps.map((d) => catalog.plugins.find((x) => x.name === d.name));
const model = installModel({
  slug: repoSlug(config), repoUrl: config.repo, marketplace: catalog.marketplace.name,
  plugin: p.name, version: p.version, deps: deps.map((d) => d.name), tagged: p.page.tagged,
});
const totalCost = p.page.contextCost !== null && depPlugins.every((d) => d && d.page.contextCost !== null)
  ? depPlugins.reduce((sum, d) => sum + d.page.contextCost, p.page.contextCost) : null;
const examples = (p.page.howToUse ?? []).slice(0, 2).map((e: any) => ({ prompt: e.prompt, resultHtml: markdown(e.result, p.page.readmePath) }));
const hasHooks = [p, ...depPlugins].some((x) => x?.page.components.some((id: string) => byId.get(id)?.kind === "hook"));
---
<Base title={p.name} description={p.description} path={p.path}>
  <header class="page-head">
    <a class="t-caption" href={href()}>{t("plugin.back")}</a>
    <KindLabel kind="plugin" class="page-head__kind" />
    <h1 class="t-display page-head__title">{p.name}</h1>
    <p class="t-body-lg t-secondary measure">{p.description}</p>
  </header>

  <div class="layout-rail">
    <aside aria-label={t("details.aria")} class="rail">
      <MetaRail rows={[
        { k: t("field.version"), v: p.version, mono: true },
        { k: t("field.category"), v: p.category },
        { k: t("field.license"), v: p.page.license },
        { k: t("field.released"), v: latest?.date ?? null, mono: true },
      ]} />
      <section class="rail__block" aria-labelledby="deps">
        <h2 id="deps" class="t-label">{t("relations.dependsOn")}</h2>
        {p.page.dependencies.length ? (
          <ul class="list t-body">
            {p.page.dependencies.map((d) => (
              <li><DependencyLink dep={d} href={href(`${d.name}/`)} version={versionOf(d.name)} /></li>
            ))}
          </ul>
        ) : <p class="t-secondary">{t("plugin.dependsOn.none")}</p>}
      </section>
      <section class="rail__block rule-bottom" aria-labelledby="used-by">
        <h2 id="used-by" class="t-label">{t("relations.usedBy")}</h2>
        {p.page.usedBy.length ? (
          <ul class="list t-body">{p.page.usedBy.map((u) => <li><a href={href(`${u}/`)}>{u}</a></li>)}</ul>
        ) : <p class="t-secondary">{t("plugin.usedBy.none")}</p>}
      </section>
    </aside>

    <div class="main">
      <div class="facts">
        {p.tags.length > 0 && (
          <div class="facts__group">
            <h2 class="t-label">{t("tags")}</h2>
            <ul class="tags">{p.tags.map((t) => <li><a class="tag t-mono" href={href(`?tag=${encodeURIComponent(t)}`)}>{t}</a></li>)}</ul>
          </div>
        )}
        <div class="facts__group">
          <h2 class="t-label">{t("compat.title")}</h2>
          <CompatBadge compat={p.compat} verified />
        </div>
      </div>

      <InstallPanel plugin={p.name} model={model} alsoInstalls={deps} contextCost={p.page.contextCost} totalCost={totalCost}
        minVersion={p.compat.claudeCode} hasHooks={hasHooks} />
      {model.download && <DownloadLink url={model.download} tag={model.tag} />}

      <section class="block" aria-labelledby="components">
        <h2 id="components" class="t-heading-2">{t("plugin.components")}</h2>
        {components.length ? (
          <ComponentGroups plugin={p.name} components={components} />
        ) : (
          <EmptyState title={t("plugin.components.empty.title")}
            text={t("plugin.components.empty.text")} />
        )}
      </section>

      <TryIt plugin={p.name} components={components} examples={examples} model={model} />

      <ManageBlock plugin={p.name} marketplace={catalog.marketplace.name} model={model} usedBy={p.page.usedBy} />

      <section class="block" aria-labelledby="latest">
        <h2 id="latest" class="t-heading-2">{t("plugin.latest")}</h2>
        {latest ? (
          <>
            <p class="release">
              <span class="t-mono release__version">{latest.version}</span>
              <span class="t-mono t-secondary">{latest.date}</span>
              {latest.rollback && <span class="t-label release__rollback">{t("release.rollback")}</span>}
            </p>
            <Prose html={markdown(latest.notes, `${p.source}/CHANGELOG.md`)} />
            <p class="t-caption"><a href={githubSource(`${p.source}/CHANGELOG.md`)}>{t("plugin.latest.changelog")}</a></p>
          </>
        ) : <p class="t-secondary">{t("plugin.latest.none")}</p>}
      </section>



      {p.page.readme && (
        <div class="block">
          <Prose html={markdown(p.page.readme, p.page.readmePath)} source="README.md" sourceHref={githubSource(p.page.readmePath)} />
        </div>
      )}

      <section class="block" aria-labelledby="compat-notes">
        <h2 id="compat-notes" class="t-heading-2">{t("plugin.compatNotes")}</h2>
        {compat.file ? (
          <>
            <dl class="compat">
              {compat.claudeCodeRaw && <><dt class="t-label">{t("plugin.compatNotes.claudeCode")}</dt><dd>{compat.claudeCodeRaw}</dd></>}
              {compat.osRaw && <><dt class="t-label">{t("field.os")}</dt><dd>{compat.osRaw}</dd></>}
            </dl>
            <p class="t-caption"><a href={githubSource(compat.file)}>{t("plugin.compatNotes.source")}</a></p>
          </>
        ) : <p class="t-secondary">{t("plugin.compatNotes.none")}</p>}
      </section>
    </div>
  </div>
</Base>

<style>
  .page-head { display: flex; flex-direction: column; gap: var(--space-3); padding-block: var(--space-8) var(--space-7); }
  .page-head :global(.page-head__kind) { margin-top: var(--space-6); }
  .page-head__title { animation: wipe-in var(--duration-reveal) var(--ease-settle) both; }
  .rail { display: flex; flex-direction: column; min-width: 0; }
  .rail__block { display: flex; flex-direction: column; gap: var(--space-2); padding-block: var(--space-4); border-top: var(--rule-thin) solid var(--rule-hairline); }
  .list { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .main { display: flex; flex-direction: column; gap: var(--space-7); min-width: 0; }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-5) var(--space-7); }
  .facts__group { display: flex; flex-direction: column; gap: var(--space-2); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .tag {
    display: inline-block;
    padding: 0 var(--space-2);
    background: var(--surface-sunken);
    border-radius: var(--radius-s);
    font-size: var(--type-label);
    color: var(--ink-secondary);
    text-decoration: none;
  }
  .tag:hover { color: var(--accent-indigo); }
  .block { display: flex; flex-direction: column; gap: var(--space-4); padding-top: var(--space-5); border-top: var(--rule-thin) solid var(--rule-hairline); }
  .release { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-4); }
  .release__version { font-weight: var(--weight-medium); }
  .release__rollback { color: var(--signal-rollback); }
  .compat { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-5); margin: 0; }
  .compat dd { margin: 0; }
</style>
