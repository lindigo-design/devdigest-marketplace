---
// GitHub Pages serves this for unknown paths.
import EmptyState from "../components/EmptyState.astro";
import { href } from "../data/site.mjs";
import { t } from "../i18n/t.mjs";
import Base from "../layouts/Base.astro";
---
<Base title={t("notFound.title")} path="404.html">
  <div class="nf">
    <h1 class="t-display">{t("notFound.heading")}</h1>
    <EmptyState variant="page" title={t("notFound.empty.title")}
      text={t("notFound.empty.text")}>
      <a class="button button--primary" href={href()}>{t("notFound.action")}</a>
    </EmptyState>
  </div>
</Base>

<style>
  .nf { display: flex; flex-direction: column; gap: var(--space-6); padding-block: var(--space-8); }
</style>
