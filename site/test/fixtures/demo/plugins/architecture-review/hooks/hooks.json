{
  "description": "Blocks git push until the PR self-review has passed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.mjs\"",
            "timeout": 30,
            "env": {
              "GATE_TOKEN": "FIXTURE_SECRET_HOOK_ENV"
            }
          }
        ]
      }
    ]
  }
}
